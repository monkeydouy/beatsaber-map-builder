# ---------------------------------------------------------------------------
# SaberMapper AI configuration
#
# Copy to `.env` and adjust. Every value has a working default, so an empty
# `.env` is fine for local development.
# ---------------------------------------------------------------------------

# --- application ----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Where job data (source audio, analysis, generated maps) is written.
STORAGE_PATH=storage

# --- ports ----------------------------------------------------------------
WEB_PORT=3000
API_PORT=8000

# The API URL the *browser* will call. Next.js inlines this at build time, so
# changing it requires a rebuild of the web image.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Browser origins allowed to call the API (comma separated).
# Leave unset: docker-compose derives it from WEB_PORT, so the API always
# allows exactly the origin the browser will send. Set it only to add an
# origin compose cannot know about (a LAN address, a tunnel).
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- resource limits ------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_AUDIO_DURATION_SECONDS=600
MAX_CONCURRENT_JOBS=2
JOB_RETENTION_HOURS=6
CLEANUP_INTERVAL_SECONDS=900

FFMPEG_TIMEOUT_SECONDS=120
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=120
YOUTUBE_METADATA_TIMEOUT_SECONDS=30

# --- external tools -------------------------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
YTDLP_BINARY=yt-dlp

# Set to false to remove the YouTube tab entirely.
ENABLE_YOUTUBE=true

# --- analysis -------------------------------------------------------------
ANALYSIS_SAMPLE_RATE=44100
ANALYSIS_HOP_LENGTH=512

# Allow a piecewise tempo map (v3 bpmEvents) for songs that do not hold a
# steady tempo. Set false to force one constant BPM for maximum compatibility
# with older third-party mapping tools.
ENABLE_VARIABLE_TEMPO=true

# Writes musical_events.json, selected_rhythm.json, generated_patterns.json and
# difficulty_analysis.json into each job directory. Development only.
DEBUG_MAPPING=false
